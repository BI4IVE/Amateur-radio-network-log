# ===== 测试环境配置样例（复制为 .env 后填入真实值）=====

# 数据库连接（src/storage/database/db.ts 的本地 pg Pool 会读取此变量）
DATABASE_URL=postgresql://用户名:密码@localhost:5432/radio_network_log

# 服务端口（Next.js 启动端口）
PORT=5000

# 运行环境：测试用 development，正式部署用 production
NODE_ENV=development

# JWT 签名密钥（必填！缺失会使用硬编码默认值，存在被伪造 token 的风险）
# 请用足够随机的长字符串，例如：openssl rand -base64 48
JWT_SECRET=请替换为随机生成的强密钥

# 初始化管理员密码（可选）
# 首次访问 POST /api/init 创建 ADMIN 账户时使用的密码；
# 不设则用随机密码并在返回结果中显示一次。
ADMIN_INIT_PASSWORD=

# ===== 版本检测（后台「版本更新」菜单）=====
# 远程版本清单地址。后台检测新版本时会拉取此 JSON，比对 latest 字段与数据库当前版本。
# 推荐：将仓库中 version/upgrade-manifest.json 提交到 GitHub，并设置下面的 raw 地址。
# 以后发新版本只需改该文件的 latest / changelog 并提交，程序即可检测到。
# 别人无法修改你的仓库文件（除非有写权限），且本功能只展示不自动升级，安全。
# 不设则默认读取同域 /version/upgrade-manifest.json
UPGRADE_MANIFEST_URL=https://raw.githubusercontent.com/BI4IVE/Amateur-radio-network-log/main/version/upgrade-manifest.json
