# ===== 测试环境配置样例（复制为 .env 后填入真实值）=====

# 数据库连接（src/storage/database/db.ts 的本地 pg Pool 会读取此变量）
DATABASE_URL=postgresql://用户名:密码@localhost:5432/radio_network_log

# 服务端口（Next.js 启动端口）
PORT=5000

# 运行环境：测试用 development，正式部署用 production
NODE_ENV=development

# JWT 签名密钥（必填！缺失会使用硬编码默认值，存在被伪造 token 的风险）
# 请用足够随机的长字符串，例如：openssl rand -base64 48
JWT_SECRET=请替换为随机生成的强密钥

# 初始化管理员密码（可选）
# 首次访问 POST /api/init 创建 ADMIN 账户时使用的密码；
# 不设则用随机密码并在返回结果中显示一次。
ADMIN_INIT_PASSWORD=
